{
  "manifest_version": 3,
  "name": "Endoplexity",
  "key": "",
  "version": "0.2.0",
  "description": "Agentic browser control driven by your own Claude / Cursor subscriptions",
  "permissions": ["sidePanel", "debugger", "tabs", "tabGroups", "storage"],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Endoplexity",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
