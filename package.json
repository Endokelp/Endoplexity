    "test:laya": "node --test bridge/test/laya.live.ts",
    "reflex:train": "node scripts/reflex-train.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "unpdf": "^1.8.0",
    "ws": "^8.18.0",
