{
  "name": "endoplexity",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Agentic browser control driven by your own Claude / Cursor subscriptions",
  "scripts": {
    "start": "node bridge/src/index.ts",
    "setup": "node scripts/setup.mjs",
    "cursor-login": "node bridge/src/cursor-login.ts",
    "codex-login": "node bridge/src/codex-login.ts",
    "bench": "node scripts/bench.ts",
